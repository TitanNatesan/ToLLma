{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail@4.10.3"
  ],
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": ["python3", "-m", "graphify.serve", "graphify-out/graph.json"],
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "postgres": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://postgres:postgres@localhost:5432/tollms"],
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "git": {
        "type": "local",
        "command": ["uvx", "mcp-server-git", "--repository", "."]
      },
      "docker": {
        "type": "local",
        "command": ["npx", "-y", "mcp-server-docker"],
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  }
}
