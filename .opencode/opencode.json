{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": ["python3", "-m", "graphify.serve", "graphify-out/graph.json"],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
