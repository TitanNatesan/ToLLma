{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": ["python3", "-m", "graphify.serve", "graphify-out/graph.json"],
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp"]
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  }
}
