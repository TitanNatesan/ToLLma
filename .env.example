################################
# PROJECT
################################

PROJECT_NAME=ToLLma
PROJECT_DESCRIPTION="Toll to your Large Language Models & Agents"

ENVIRONMENT=local

DEBUG=true

################################
# FRONTEND
################################

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

NEXT_PUBLIC_APP_NAME=ToLLma
NEXT_PUBLIC_APP_DESCRIPTION="Toll to your Large Language Models & Agents"
# Browser -> backend (host-mapped port, used by client components).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Container -> container (service name, used by server components / SSR).
BACKEND_URL=http://backend:8000

################################
# BACKEND
################################

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

API_V1_PREFIX=/api/v1

SECRET_KEY=local-dev-secret-key-change-in-prod-32chars!!

################################
# POSTGRES
################################

POSTGRES_DB=tollms

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

################################
# CORS
################################

BACKEND_CORS_ORIGINS=http://localhost:3000

#################################
# STORAGE
#################################

LOCAL_STORAGE_PATH=./storage

################################
# VALKEY (cache)
################################

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
CACHE_ENABLED=true

################################
# LOGGING
################################

LOG_LEVEL=INFO
